# Seed data for the disposable `openldap-test` container.
#
# Composition:
#   - ou=people                                            (base OU)
#   - 6 named entries across 5 departments (Engineering x2, Research,
#     Sales, Support, Marketing) — for excluded_departments / get_departments()
#   - 2 named entries with NO `department` attribute        — for exclude_no_department
#   - 510 "Bulk User NNN" entries, department=Operations     — forces >1 page in
#     search_paged() (RFC 2696), page size is hardcoded to 500 in the connector
#
# The bulk block was generated with:
#   ./generate-bulk-entries.sh 510 >> directory.ldif   (appended after the header below)
#
# `department` and `ipPhone` require the custom schema at
# schema/ldap-ed-test.schema — mounted by bin/ldap-test-env.sh.
#
# exclude_disabled is intentionally NOT covered here — see design.md, Decision 6.

dn: ou=people,dc=example,dc=test
objectClass: organizationalUnit
ou: people

dn: cn=Ada Lovelace,ou=people,dc=example,dc=test
objectClass: inetOrgPerson
objectClass: ldapEdTestPerson
cn: Ada Lovelace
sn: Lovelace
displayName: Ada Lovelace
mail: ada.lovelace@example.test
title: Principal Engineer
department: Engineering
telephoneNumber: +1 555 0101
ipPhone: 1001

